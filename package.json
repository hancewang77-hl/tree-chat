{
  "name": "tree-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:coverage": "vitest run --coverage",
    "runtime:dev": "python -m uvicorn runtime.app.main:app --reload --port 8000",
    "runtime:test": "python -m pytest runtime/tests -q",
    "runtime:mock-workers": "python -m runtime.mock_worker.launcher",
    "runtime:mock-worker-1": "python -m runtime.mock_worker.launcher --worker worker-1",
    "runtime:mock-worker-2": "python -m runtime.mock_worker.launcher --worker worker-2",
    "runtime:real-worker": "python -m runtime.real_worker.launcher",
    "runtime:vllm-server": "wsl -d Ubuntu -- bash runtime/vllm/start_vllm.sh"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.0",
    "animejs": "4.5.0",
    "d3-hierarchy": "^3.1.2",
    "katex": "^0.16.47",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
